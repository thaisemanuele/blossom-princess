    "gitDecoration.stageModifiedResourceForeground": "#6FC597",
    "gitDecoration.untrackedResourceForeground": "#92b8dd",
    "gitDecoration.addedResourceForeground": "#92b8dd",
    "gitDecoration.renamedResourceForeground": "#92b8dd",
    "gitDecoration.deletedResourceForeground": "#f08a9a",
