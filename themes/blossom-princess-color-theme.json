    "modernTab.activeBackground": "#33283A",
    "modernTab.activeForeground": "#efe6dc",
    "modernTab.hoverBackground": "#2a2230",
    "modernTab.hoverForeground": "#efe6dc",
    "modernPanel.border": "#2a2230",
    "modernUI.shellBackground": "#141015",
    "terminalCursor.foreground": "#f1d6ae",
    "terminal.selectionBackground": "#5B2B3Ecc",
    "terminal.findMatchBackground": "#ec6f8355",
