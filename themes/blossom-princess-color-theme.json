    "titleBar.activeBackground": "#170d15",
    "statusBar.background": "#170d15",
    "panel.background": "#170d15",
    "terminal.background": "#170d15",
    "list.activeSelectionBackground": "#ba344ccc",
    "list.hoverBackground": "#481926",
    "list.highlightForeground": "#F07A8E",
    "button.background": "#ba344c",
    "button.foreground": "#efe6dc",
    "badge.background": "#ba344c",
    "badge.foreground": "#efe6dc",
    "progressBar.background": "#F07A8E",
    "input.background": "#33202f",
