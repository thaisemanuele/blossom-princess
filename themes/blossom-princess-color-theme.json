    "sideBarTitle.foreground": "#abaeb1",
    "sideBarSectionHeader.background": "#141015",
    "sideBarSectionHeader.foreground": "#abaeb1",
    "sideBarSectionHeader.border": "#2a2230",
    "list.activeSelectionForeground": "#efe6dc",
    "list.inactiveSelectionBackground": "#2a2230",
    "list.inactiveSelectionForeground": "#ddd7d1",
    "list.hoverForeground": "#efe6dc",
    "tree.indentGuidesStroke": "#3a2e3d",
    "activityBar.inactiveForeground": "#acc2d4",
