    "terminal.ansiBrightGreen": "#a6c6b2",
    "terminal.ansiYellow": "#F1D6AE",
    "terminal.ansiBrightYellow": "#f5e2c6",
    "terminal.ansiBlue": "#ec6f83",
    "terminal.ansiBrightBlue": "#f29aa8",
    "terminal.ansiMagenta": "#F2A0AE",
    "terminal.ansiBrightMagenta": "#f7c4cd",
    "terminal.ansiCyan": "#92B8DD",
    "terminal.ansiBrightCyan": "#b1c9df",
    "terminal.ansiWhite": "#ddd7d1",
    "terminal.ansiBrightWhite": "#efe6dc",
    "button.hoverBackground": "#A3384F"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6e8fae",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ec6f83"
      }
    },
    {
      "name": "Control flow and module keywords (import, export, return, if)",
      "scope": [
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#F2A0AE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#ec6f83"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#ec6f83"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#ec6f83"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#92b8dd"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#92b8dd"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#92b8dd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6fc597"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#f1d6ae",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f1d6ae"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#e9c27d",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#92b8dd",
    "method": "#92b8dd",
    "class": {
      "foreground": "#f1d6ae",
      "italic": true
    },
    "type": {
      "foreground": "#f1d6ae",
      "italic": true
    },
    "interface": {
      "foreground": "#f1d6ae",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#f1d6ae",
      "italic": true
    },
    "enum": {
      "foreground": "#f1d6ae",
      "italic": true
    },
    "enumMember": {
      "foreground": "#e9c27d",
      "italic": true
    },
    "property.declaration": "#efe6dc",
    "parameter": {
      "italic": true
    },
    "property": "#efe6dc"
  }
}
